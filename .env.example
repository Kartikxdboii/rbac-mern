# === Server configuration ===
# Preferred port for the integrated Express + Vite dev server
PORT=3000
# development | production
NODE_ENV=development

# === Database (MySQL with Drizzle ORM) ===
# Format: mysql://USER:PASSWORD@HOST:PORT/DBNAME
# Example below works with the docker-compose.yml in this repo
DATABASE_URL=mysql://root:example@localhost:3306/rbac

# === JWT Authentication ===
# Secret used to sign session JWTs (set a strong, unique value in real environments)
JWT_SECRET=change_me_in_dev

# === External API integrations (optional) ===
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# === OAuth configuration ===
# Backend OAuth server base URL used for token exchange and user info
# e.g. https://auth.your-domain.com
OAUTH_SERVER_URL=
# Owner openId receives admin role on first upsert
OWNER_OPEN_ID=

# === Frontend configuration (Vite) ===
# Manus/App ID used by auth flows
VITE_APP_ID=rbac-mern-local
# Brand/UI
VITE_APP_TITLE=FineAccess
VITE_APP_LOGO=/fineaccess.png
# Analytics (optional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
# OAuth portal URL used by client to build the login URL (should host /app-auth or your portal page)
VITE_OAUTH_PORTAL_URL=

# Local auth (offline mode)
LOCAL_AUTH_ENABLED=true
OWNER_NAME=Admin
OWNER_OPEN_ID=admin-user
# Use either OWNER_PASSWORD or a bcrypt OWNER_PASSWORD_HASH
# OWNER_PASSWORD=admin123
# OWNER_PASSWORD_HASH=
